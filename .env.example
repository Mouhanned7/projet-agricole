# Supabase (Settings > API). Ne jamais commiter .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur : uniquement côté serveur (recalcul du classement, CLA-01)
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP (e-mails de notification) : mêmes valeurs que dans Supabase > Authentication > SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VerdOlive <no-reply@votre-domaine.tn>"

# Fond de carte MapTiler (facultatif, sinon OpenFreeMap gratuit)
NEXT_PUBLIC_MAPTILER_KEY=
