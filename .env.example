# Supabase (Settings > API). Ne jamais commiter .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur : uniquement côté serveur (recalcul du classement, CLA-01)
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mails de notification (facultatif) : https://resend.com
RESEND_API_KEY=
EMAIL_FROM="VerdOlive <notifications@votre-domaine.tn>"

# Fond de carte MapTiler (facultatif, sinon OpenFreeMap gratuit)
NEXT_PUBLIC_MAPTILER_KEY=
